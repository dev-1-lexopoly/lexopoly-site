# DOCK-020 Secrets Management Protocol
# Mandatory .gitignore patterns for Lexopoly Federation

# Environment files
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# Secret directories
secrets/
.secrets/
config/secrets/

# Certificates and keys
*.pem
*.key
*.p12
*.pfx
*.keystore

# Backend configuration (lexopoly-site specific)
backend/.env
backend/config.json
backend/*.env

# Node modules and build artifacts
node_modules/
.next/
out/
dist/
build/

# Editor directories and agent config
.vscode/
.idea/
.claude/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# Internal operations docs — never commit to public repo (INCIDENT_013)
CC-WEB_*
CC-MM_*
CC-LEX_*
CC-FCO_*
CC-SEC_*
CC-CYC_*
CC-RR_*
CC-QC_*
CC-CL_*
CC-FC_*
CC_WEB_*
*_BUS_OPS*
*_STATUS_2*
SUPER_BUS*
*SPRINT_REPORT*
*SPRINT_PLAN*
*_SPRINT_*
POWER_OUTAGE_*
SITE_SWITCHING_*

# Archive and backup artifacts — never commit to public repo (INCIDENT_015)
*.tar
*.tar.gz
*.tar.bz2
*.tar.xz
*.zip
*.7z
*.bak
*.backup-*
*-backup-*
*.old
*.orig
*.swp
